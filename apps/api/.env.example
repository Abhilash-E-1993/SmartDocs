# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/smartdocs

# Clerk API keys (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Cloudinary (PDF storage — https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firecrawl (website extraction — https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your_api_key

# OpenAI (chat, embeddings, query rewriting, verification — https://platform.openai.com)
OPENAI_API_KEY=sk-your_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone (vector database — https://app.pinecone.io)
PINECONE_API_KEY=pcsk-your_api_key
PINECONE_INDEX_NAME=smartdocs

# Mem0 (long-term conversation memory — https://app.mem0.ai)
MEM0_API_KEY=m0-your_api_key

# Inngest (leave empty for local dev — the local dev server needs no keys)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

INNGEST_API_KEY=